//TSOBATCH JOB (ACCT),'TSO BATCH UNDER DSN',CLASS=A,MSGCLASS=X
//*
//* Both steps EXEC IKJEFT01, which is never the dependency anyone wants:
//* the program a step really runs is named by RUN PROGRAM in SYSTSIN.
//* STEP01 runs Db2's DSNTIAUL, so its SYSIN is SQL and names tables (one
//* of them, ACCT_DAILY, under an alias). STEP02 runs an application
//* program under a PLAN, and its SYSIN is that program's own input.
//*
//STEP01   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSREC00 DD  DSN=PROD.ACCT.POSN.EXTRACT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5),RLSE)
//SYSPUNCH DD  DSN=PROD.ACCT.POSN.CNTL,DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(1,1),RLSE)
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(DSNTIAUL) PLAN(DSNTIB12) -
      LIB('DB2P.RUNLIB.LOAD') PARMS('SQL')
  END
/*
//SYSIN    DD  *
  SELECT A.ACCT_ID, A.ACCT_NAME, P.QTY
    FROM ACCT_DAILY A
    JOIN POSN_MASTER P ON P.ACCT_ID = A.ACCT_ID
   WHERE P.QTY > 0;
  DELETE FROM ACCT_STAGE
   WHERE LOAD_DT < CURRENT DATE - 7 DAYS;
/*
//*
//STEP02   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DSN=DB2P.SDSNLOAD,DISP=SHR
//         DD  DSN=PROD.LOADLIB,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//POSTIN   DD  DSN=PROD.ACCT.POSN.EXTRACT(+1),DISP=SHR
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(DAILYPOST) PLAN(DAILYPST)
  END
/*
//SYSIN    DD  *
POSTING DATE 20260901
/*
//
