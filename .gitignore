# Claude Code (personal, per-developer settings)
.claude/settings.json
.claude/settings.local.json

# Generated output. A run writes everything into --outdir, which defaults to ./out.
out/
# ...and these cover a run pointed somewhere else, e.g. --outdir .
*.jcl.artifacts.json
*.jcl.lineage.json
*.jcl.prefetch.json
*.jcl.fetch.json

# NOTE: goldens/ and tests/fixtures/ are deliberately NOT ignored. The committed
# manifest fixture is this package's half of a cross-repository contract, and the
# goldens are the byte-stability ratchet - both are worthless if they are not tracked.
